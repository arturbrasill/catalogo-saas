# ============================================================
# VARIÁVEIS DE AMBIENTE — SAAS CATÁLOGO DIGITAL MULTI-TENANT
# ============================================================
# Copie este arquivo para .env.local para desenvolvimento local.
# NUNCA commite arquivos .env ou .env.local contendo credenciais no Git!

# ------------------------------------------------------------
# 1. VARIÁVEIS PÚBLICAS (CLIENT-SIDE / BUNDLE FRONTEND)
# Apenas valores seguros e não-sensíveis podem ter prefixo NEXT_PUBLIC_
# ------------------------------------------------------------

# URL pública da aplicação Next.js
NEXT_PUBLIC_APP_URL=https://saasnumclick.vercel.app

# Tenant padrão para desenvolvimento local (localhost / 127.0.0.1)
NEXT_PUBLIC_DEFAULT_TENANT=loja_exemplo

# Provedor de Upload de Imagens Externo (Cloudinary)
# Utiliza-se "Unsigned Upload Preset" (apenas upload direto seguro, sem expor API Secret)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=seu-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=catalogo_unsigned_preset
# Aliases alternativos suportados:
# NEXT_PUBLIC_IMAGE_UPLOAD_PROVIDER=cloudinary
# NEXT_PUBLIC_IMAGE_UPLOAD_CLOUD_NAME=seu-cloud-name
# NEXT_PUBLIC_IMAGE_UPLOAD_PRESET=catalogo_unsigned_preset

# ------------------------------------------------------------
# 2. VARIÁVEIS PRIVADAS (SERVER-SIDE ONLY)
# NUNCA utilizar prefixo NEXT_PUBLIC_. Acessíveis apenas em Route Handlers.
# ------------------------------------------------------------

# URL de fallback para o Google Apps Script (quando não resolvido via multi-tenant)
# Em produção, as URLs individuais dos tenants ficam mapeadas em src/lib/tenants.json
APPS_SCRIPT_URL=

# Ambiente de execução (development | production | test)
NODE_ENV=development

# ------------------------------------------------------------
# 3. INTEGRAÇÃO DE PAGAMENTOS — ASAAS
# ------------------------------------------------------------
# Chave de API gerada no painel do Asaas (Configurações -> Integrações)
ASAAS_API_KEY=
# Ambiente do Asaas: 'sandbox' (testes) ou 'production' (produção)
ASAAS_ENVIRONMENT=sandbox
# Token secreto de validação de webhook do Asaas
ASAAS_WEBHOOK_SECRET=

# ------------------------------------------------------------
# 4. CHAVE MESTRE DO PAINEL SUPERADMIN SAAS
# ------------------------------------------------------------
SAAS_MASTER_PASSWORD=master2026
SAAS_MASTER_KEY=master_saas_antigravity_2026

# ------------------------------------------------------------
# 5. PERSISTÊNCIA EM NUVEM SERVERLESS (OPCIONAL — VERCEL KV / UPSTASH)
# Permite persistir lojas criadas dinamicamente em ambientes serverless sem disco gravável
# ------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Ou via Upstash:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------
# 6. BANCO DE DADOS OFICIAL — SUPABASE (POSTGRESQL & REST)
# ------------------------------------------------------------
# URL do projeto Supabase (Configurações -> API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública/anon do Supabase (para chamadas autenticadas no frontend/RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço (service_role) do Supabase (apenas server-side / APIs de admin)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# 7. AUTO-PROVISIONAMENTO PRIVADO NO GOOGLE DRIVE (OPCIONAL/LEGACY)
# URL do Web App Apps Script (backend/MasterProvisioner.gs)
# ------------------------------------------------------------
GOOGLE_MASTER_PROVISIONER_URL=

