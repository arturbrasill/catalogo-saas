# URL pública da aplicação (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tenant padrão para desenvolvimento local
NEXT_PUBLIC_DEFAULT_TENANT=loja_exemplo

# Upload de imagens (provedor externo: Cloudinary, ImgBB, etc.)
# IMPORTANTE: Nunca insira chaves privadas ou tokens com permissão de escrita em NEXT_PUBLIC_
IMAGE_UPLOAD_PROVIDER=cloudinary
IMAGE_UPLOAD_PRESET=catalogo_unsigned_preset
IMAGE_UPLOAD_CLOUD_NAME=sua-cloud-name

# Configuração de ambiente
NODE_ENV=development
