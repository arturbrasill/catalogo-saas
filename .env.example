# ============================================================
# VARIÁVEIS DE AMBIENTE — SAAS CATÁLOGO DIGITAL MULTI-TENANT
# ============================================================
# Copie este arquivo para .env.local para desenvolvimento local.
# NUNCA commite arquivos .env ou .env.local contendo credenciais no Git!

# ------------------------------------------------------------
# 1. VARIÁVEIS PÚBLICAS (CLIENT-SIDE / BUNDLE FRONTEND)
# Apenas valores seguros e não-sensíveis podem ter prefixo NEXT_PUBLIC_
# ------------------------------------------------------------

# URL pública da aplicação Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tenant padrão para desenvolvimento local (localhost / 127.0.0.1)
NEXT_PUBLIC_DEFAULT_TENANT=loja_exemplo

# Provedor de Upload de Imagens Externo (Cloudinary)
# Utiliza-se "Unsigned Upload Preset" (apenas upload direto seguro, sem expor API Secret)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=seu-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=catalogo_unsigned_preset
# Aliases alternativos suportados:
# NEXT_PUBLIC_IMAGE_UPLOAD_PROVIDER=cloudinary
# NEXT_PUBLIC_IMAGE_UPLOAD_CLOUD_NAME=seu-cloud-name
# NEXT_PUBLIC_IMAGE_UPLOAD_PRESET=catalogo_unsigned_preset

# ------------------------------------------------------------
# 2. VARIÁVEIS PRIVADAS (SERVER-SIDE ONLY)
# NUNCA utilizar prefixo NEXT_PUBLIC_. Acessíveis apenas em Route Handlers.
# ------------------------------------------------------------

# URL de fallback para o Google Apps Script (quando não resolvido via multi-tenant)
# Em produção, as URLs individuais dos tenants ficam mapeadas em src/lib/tenants.json
APPS_SCRIPT_URL=

# Ambiente de execução (development | production | test)
NODE_ENV=development
